sensor:
  name: {{ component_domain }}_installed_version
  unique_id: {{ component_domain }}_installed_version
  command: >-
    python3 -c "from pathlib import Path; source = Path('/config/custom_components/{{ component_domain }}/.deployed-source').read_text().strip(); print(source.rsplit('@', 1)[1].split('#', 1)[0])"
  # 6 hours in seconds.
  scan_interval: 21600
