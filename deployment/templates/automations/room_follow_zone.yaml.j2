{% set ha_start = '{{' %}
{% set ha_end = '}}' %}

- id: room_follow_zone_setpoints
  alias: Room follow zone setpoints
  trigger:
    - platform: state
      entity_id: climate.landing
      attribute: temperature
    - platform: homeassistant
      event: start
    - platform: event
      event_type: automation_reloaded
  condition:
    - condition: template
      value_template: "{{ ha_start }} is_number(state_attr('climate.landing', 'temperature')) {{ ha_end }}"
  action:
    - variables:
        landing_setpoint: "{{ ha_start }} state_attr('climate.landing', 'temperature') | float {{ ha_end }}"
    # Landing is the coldest and least-used area; keep radiators warmer than the
    # landing setpoint to avoid wasting energy heating the stairwell.
{% for trv in thermostat_devices %}
    - service: climate.set_temperature
      target:
        entity_id: {{ trv.entity_id }}
      data:
        temperature: "{{ ha_start }} landing_setpoint + ({{ trv.setpoint_offset | default(5) }}) {{ ha_end }}"
{% endfor %}
  mode: restart
