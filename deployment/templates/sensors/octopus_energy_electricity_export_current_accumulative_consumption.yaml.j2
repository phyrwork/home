# This sensor fakes a current accumulative export sensor by integrating the faked
# current export sensor.
platform: integration
name: Current Accumulative Consumption Export Electricity ({{ electricity_meter_serial_number }}/{{ electricity_meter_mpan_export }})
source: sensor.{{ ("current_export_electricity_" ~ electricity_meter_serial_number ~ "_" ~ electricity_meter_mpan_export) | lower }}
unique_id: {{ ("current_accumulative_consumption_export_electricity_" ~ electricity_meter_serial_number ~ "_" ~ electricity_meter_mpan_export) | lower }}
unit_prefix: k
round: 2
# Hold the last observed power until the next reading. This avoids attributing
# a new export level to the preceding interval when export starts.
method: left
max_sub_interval:
  minutes: 1
